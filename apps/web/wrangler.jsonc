{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Server rendering and static files; the edge worker sends app requests here (service binding).
  "name": "andesine-web",
  "main": "./dist/worker/worker.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  // Vite builds the Worker; its chunks, e.g. icon sets, upload as separate modules loaded on use.
  "no_bundle": true,
  "base_dir": "./dist/worker",
  "find_additional_modules": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js"] }],
  "workers_dev": false,
  // Runs near the API, as each page calls it.
  "placement": { "mode": "smart" },
  "dev": { "port": 43218 },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
