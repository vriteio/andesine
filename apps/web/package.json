{
  "name": "@andesine/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch ./src/server/index.ts",
    "build": "pnpm build:client && pnpm build:server && pnpm build:runtime",
    "build:client": "vite build --outDir dist/client --ssrManifest",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server.tsx",
    "build:runtime": "rolldown -c rolldown.config.mjs",
    "start": "NODE_ENV=production node ./dist/server/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@andesine/components": "workspace:*",
    "@andesine/contracts": "workspace:*",
    "@andesine/document": "workspace:*",
    "@andesine/editor": "workspace:*",
    "@ark-ui/solid": "^5.38.0",
    "@atlaskit/pragmatic-drag-and-drop": "2.0.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "2.0.0",
    "@better-auth/passkey": "1.7.18",
    "@fastify/middie": "^9.3.3",
    "@fastify/static": "^10.1.2",
    "@iconify/json": "^2.2.509",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "@signaldb/core": "^1.8.1",
    "@signaldb/solid": "^1.0.0",
    "@solid-primitives/media": "^2.3.6",
    "@solid-primitives/scheduled": "^1.5.3",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@tanstack/solid-query": "^5.101.4",
    "base-x": "catalog:",
    "better-auth": "1.7.18",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fastify": "^5.12.8",
    "idb": "^8.0.3",
    "lexorank": "catalog:",
    "marked": "15.0.12",
    "posthog-js": "1.438.10",
    "solid-js": "^1.9.18",
    "tinykeys": "^4.0.0",
    "yjs": "catalog:"
  },
  "devDependencies": {
    "@andesine/sdk": "workspace:*",
    "@andesine/uno-preset": "workspace:*",
    "@types/node": "^26.1.2",
    "@unocss/reset": "^66.7.5",
    "rolldown": "^1.2.2",
    "sass-embedded": "^1.100.0",
    "tsx": "^4.23.5",
    "unocss": "^66.7.5",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.14",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  }
}
