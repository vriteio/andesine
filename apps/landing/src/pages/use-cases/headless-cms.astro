---
import SitePage from "../../components/shared/site-page/index.astro";
import { Workflow } from "../../components/sections/workflow";
import { Publishing } from "../../components/sections/publishing";

const title = "Headless CMS — Andesine";
const description =
  "Manage blogs, changelogs, and in-app content in Andesine and deliver it through the content API.";
---

<SitePage
  title={title}
  description={description}
  path="/use-cases/headless-cms/"
  heading="Content for your blog, changelog, and app."
  subheading="Write in an editor. Deliver through the API."
>
  <Workflow />
  <Publishing client:visible />
</SitePage>
