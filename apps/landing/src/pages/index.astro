---
import { LandingPage } from "../components/landing-page";
import { HeroRibbon } from "../components/sections/hero/hero-ribbon";
import { SiteHeader } from "../components/shared/site-header";
import { Publishing } from "../components/sections/publishing";
import DocumentHead from "../components/shared/document-head/index.astro";
import { PageScrollShadows } from "../components/shared/page-scroll-shadows";
import { Analytics } from "../components/shared/analytics";
import { links } from "../links";
import "../styles.scss";

// Fetched once per build; the count is hidden when GitHub can't be reached.
const stars = await fetch("https://api.github.com/repos/vriteio/andesine")
  .then((response) => (response.ok ? response.json() : undefined))
  .then((repository) => repository?.stargazers_count as number | undefined)
  .catch(() => undefined);
const title = "Andesine — Bring your content together";
const description =
  "Docs, knowledge, and structured content in one open-source workspace. Write with your team and AI agents, and publish anywhere.";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://andesine.app/#organization",
      "name": "Andesine",
      "url": "https://andesine.app/",
      "logo": "https://andesine.app/favicon.svg",
      "sameAs": [links.repository, links.social.x, links.social.linkedin]
    },
    {
      "@type": "WebSite",
      "name": "Andesine",
      "url": "https://andesine.app/",
      "publisher": { "@id": "https://andesine.app/#organization" }
    },
    {
      "@type": "SoftwareApplication",
      "name": "Andesine",
      "url": "https://andesine.app/",
      description,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "publisher": { "@id": "https://andesine.app/#organization" },
      "offers": [
        { "@type": "Offer", "name": "Free", "price": "0", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Pro", "price": "12", "priceCurrency": "USD" }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en" class="scrollbar-contrast" style="background-color: #f9fafb">
  <head>
    <DocumentHead title={title} description={description} path="/" jsonLd={jsonLd} />
  </head>
  <body style="background-color: #f9fafb">
    <PageScrollShadows client:load />
    <Analytics client:only="solid-js" />
    <LandingPage stars={stars}>
      <SiteHeader slot="header" client:load />
      <HeroRibbon slot="ribbon" client:load />
      <Publishing slot="publishing" client:visible />
    </LandingPage>
    <script>
      import { initEntryAnimations } from "../entry-animations";
      import { loadWebMCPTools } from "@andesine/pages/webmcp";

      initEntryAnimations();
      loadWebMCPTools("/docs/").catch((error: unknown) => console.warn(error));
    </script>
  </body>
</html>
