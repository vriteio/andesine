---
import SitePage from "../components/shared/site-page/index.astro";
import { links } from "../links";
import { HeroSection } from "../components/sections/hero/hero-section";
import { HeroRibbon } from "../components/sections/hero/hero-ribbon";
import { CallToAction } from "../components/sections/call-to-action";
import { PagesOptions, PagesFeatures, PagesReference } from "../components/sections/pages";

const title = "Andesine Pages — Your docs, published in a click";
const description =
  "Turn your docs into a site with search and AI answers. Host it with us, or build your own from the open-source template.";
---

<SitePage title={title} description={description} path="/pages/">
  <HeroSection
    slot="hero"
    heading="Your docs, ready to share."
    highlight="Published in a click."
    subheading="Host it with us, or yourself. Search and AI answers built in."
    secondaryLabel="Read the docs"
    secondaryLink={links.hostedSites}
    screenshot="/_landing/screenshots/pages-docs.png"
    screenshotLabel="Docs site built with Andesine Pages"
  >
    <HeroRibbon slot="ribbon" client:load />
  </HeroSection>
  <PagesOptions />
  <PagesFeatures />
  <PagesReference />
  <CallToAction
    slot="cta"
    title="Share your docs today."
    subtitle="Start free, or build your own site from the template."
    secondaryTitle="Read the guide"
    secondaryLink={links.pagesFramework}
    secondaryIcon="i-lucide:book-open"
  />
</SitePage>
