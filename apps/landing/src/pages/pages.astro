---
import SitePage from "../components/shared/site-page/index.astro";

const title = "Andesine Pages — Docs sites from your workspace";
const description =
  "Andesine Pages turns a collection into a documentation site with search and AI answers. Host it in a click, or build it with the open-source template.";
---

<SitePage
  title={title}
  description={description}
  path="/pages/"
  heading="Docs sites, straight from your workspace."
  subheading="Search and AI answers built in. Hosted in a click, or open source to run anywhere."
/>
