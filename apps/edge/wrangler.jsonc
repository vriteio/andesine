{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "andesine-edge",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "keep_vars": true,
  "dev": { "port": 43212 },
  // The web app; local development sets APP_ORIGIN instead.
  "services": [{ "binding": "APP", "service": "andesine-web" }],
  "assets": {
    "directory": "../landing/dist",
    "binding": "LANDING",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
