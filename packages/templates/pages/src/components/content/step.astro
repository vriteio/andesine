---
interface Props {
  title: string;
}
---

<li
  class:list={[
    "relative m-0 pl-11 [counter-increment:step] [&:not(:last-child)]:pb-4",
    "before:(absolute left-0 top-0 flex h-7 w-7 items-center justify-center rounded-lg bg-white text-sm font-medium text-gray-700 shadow-md shadow-gray-900/8 outline outline-1 -outline-offset-1 outline-gray-200 content-[counter(step)])",
    "after:(absolute bottom-0 left-3.5 top-9 w-px rounded-full bg-gray-200 content-[''])"
  ]}
>
  <p class="mb-0 mt-0.5 font-semibold text-gray-900">{Astro.props.title}</p>
  <div class="mt-1 [&>*:first-child]:mt-0 [&>*:last-child]:mb-0"><slot /></div>
</li>
