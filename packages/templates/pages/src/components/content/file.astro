  <span class="flex h-6 w-6 shrink-0 items-center justify-center">
    <span aria-hidden="true" class="i-lucide:file-text h-6 w-6 text-gray-400"></span>
  </span>
  <span class="line-clamp-1 flex-1">{Astro.props.name}</span>
</li>
