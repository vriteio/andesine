---
interface Props {
  title: string;
  /** Card text; the slot content can be used instead. */
  description?: string;
  icon?: string;
  /** Makes the whole card a link. */
  href?: string;
}

const { title, description, icon, href } = Astro.props;
const Element = href ? "a" : "div";
---

<Element
  href={href}
  class:list={[
    "not-prose flex flex-col gap-2 rounded-xl border border-gray-200 bg-white p-4 shadow-[0_0_12px_0px] shadow-gray-200",
    href && "transition duration-200 ease-out @hover:bg-gray-100 focus-visible:bg-gray-100"
  ]}
>
  {icon && <span aria-hidden="true" class:list={["h-6 w-6 bg-gradient-to-tr", icon]} />}
  <span class="flex items-center gap-1 font-semibold text-gray-900">
    {title}
    {href && <span aria-hidden="true" class="i-lucide:arrow-right h-4 w-4 text-gray-400" />}
  </span>
  <div class="text-sm text-gray-500 [&>p]:m-0">
    {description && <p>{description}</p>}
    <slot />
  </div>
</Element>
