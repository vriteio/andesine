---
import type { PageContext } from "@andesine/pages";
import { IconButton } from "../primitives/button";
import { Logo } from "../primitives/logo";
import { SearchPalette } from "../search/search-palette";
import { CallToAction } from "./call-to-action";
import { SectionTabs } from "./section-tabs";

interface Props {
  page: PageContext;
}

const { page } = Astro.props;
const { site } = page;
---

<header class="sticky top-0 z-30 col-span-full bg-gray-50 [view-transition-name:header]">
  <div
    class="grid h-16 grid-cols-[minmax(0,1fr)_auto] items-center gap-4 px-4 md:(grid-cols-[17rem_minmax(0,1fr)_auto] gap-0 px-0) xl:grid-cols-[17rem_minmax(0,1fr)_17rem]"
  >
    <a
      href={site.href}
      class="min-w-0 rounded-lg text-gray-900 focus-visible:(outline outline-2 outline-offset-2 outline-tertiary) md:px-4"
    >
      <Logo site={site} />
    </a>
    <div class="hidden md:(block w-full max-w-screen-md justify-self-center px-8)">
      {site.search && <SearchPalette client:idle search={site.search} />}
    </div>
    <div class="flex min-w-0 items-center justify-end gap-2 md:px-4">
      {
        site.search && (
          <IconButton
            data-search-trigger
            icon="i-tabler:search"
            color="contrast"
            variant="outlined"
            size="small"
            text="softer"
            class="md:hidden"
            aria-label="Search"
          />
        )
      }
      {site.cta && <CallToAction link={site.cta} />}
    </div>
  </div>
  {
    page.sections.length > 0 && site.sectionsDisplay === "tabs" && (
      <SectionTabs client:load sections={page.sections} />
    )
  }
</header>
