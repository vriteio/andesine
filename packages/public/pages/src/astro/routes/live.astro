---
import config, { highlight } from "virtual:andesine/config";
import Layout from "virtual:andesine/layout";
import { components } from "virtual:andesine/components";
import Content from "../content.astro";
import { getLiveRoute, renderRoute } from "../../runtime.js";

export const prerender = false;

let route;

try {
  route = await getLiveRoute(config, highlight, Astro.url, Astro.request.signal);
} catch (error) {
  // Never replace an outage with stale content.
  console.error(error);

  return new Response("The documentation is not available now. Try again later.", {
    status: 503,
    headers: { "Retry-After": "30" }
  });
}

if (route.type === "redirect") return Astro.redirect(route.target);
// An empty 404 response renders the not-found page.
if (route.type === "not-found") return new Response(null, { status: 404 });

const { nodes, summary, aside, iconCSS, page } = await renderRoute(route);
---

<Layout page={page}>
  {iconCSS && <style is:inline set:html={iconCSS} />}
  {summary && <Content slot="summary" nodes={summary.children} components={components} />}
  {aside && <Content slot="aside" nodes={aside.children} components={components} />}
  <Content nodes={nodes.children} components={components} />
</Layout>
