---
import config, { highlight } from "virtual:andesine/config";
import Layout from "virtual:andesine/layout";
import { components } from "virtual:andesine/components";
import Content from "../content.astro";
import { getStaticPaths as getPaths, renderRoute } from "../../runtime.js";

export const getStaticPaths = () => getPaths(config);

const { route } = Astro.props;
const escape = (value: string) => value.replace(/[&"<>]/g, (char) => `&#${char.charCodeAt(0)};`);

// Astro's static redirect page shows text before it redirects, so this one has no body.
// Hosts can read `andesine:redirect` to send an HTTP redirect instead.
if (route.type === "redirect") {
  const target = escape(route.target);
  const canonical = escape(new URL(route.target, config.site).href);
  const script = `location.replace(${JSON.stringify(route.target).replace(/</g, "\\u003c")})`;

  return new Response(
    `<!doctype html><meta charset="utf-8"><meta http-equiv="refresh" content="0;url=${target}"><meta name="andesine:redirect" content="${target}"><meta name="robots" content="noindex"><link rel="canonical" href="${canonical}"><script>${script}</script>`,
    { headers: { "content-type": "text/html; charset=utf-8" } }
  );
}

const {
  Content: FileContent,
  operation,
  nodes,
  summary,
  aside,
  iconCSS,
  page
} = await renderRoute(route, highlight);
const Operation = components.Operation;

if (operation && !Operation) throw new Error("The template has no component for <Operation>.");
---

<Layout page={page}>
  {iconCSS && <style is:inline set:html={iconCSS} />}
  {summary && <Content slot="summary" nodes={summary.children} components={components} />}
  {aside && <Content slot="aside" nodes={aside.children} components={components} />}
  <div
    data-pagefind-body={route.indexed || undefined}
    data-pagefind-filter={route.indexed ? `source:${route.sourceID}` : undefined}
  >
    {
      route.indexed && (
        <span data-pagefind-meta="title" hidden>
          {page.title}
        </span>
      )
    }
    {
      FileContent ? (
        <FileContent components={components} />
      ) : operation ? (
        <Operation view={operation} />
      ) : (
        <Content nodes={nodes.children} components={components} />
      )
    }
  </div>
</Layout>
