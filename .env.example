### Required configuration

# Hosts
PUBLIC_API_HOST=
PUBLIC_APP_HOST=
PUBLIC_SECURE=
PUBLIC_COOKIE_DOMAIN=

# Secrets
# Generate with: openssl rand -hex 32
SECRET=

# Database
POSTGRES_PORT=5432
DATABASE_URL=postgresql://andesine:andesine@localhost:5432/andesine
REDIS_URL=

# Background jobs
QUEUE_REDIS_PORT=6380
QUEUE_REDIS_URL=redis://localhost:6380
WORKER_CONCURRENCY=4

# Search
TYPESENSE_PORT=8108
TYPESENSE_URL=http://localhost:8108
# Use a unique secret outside local development.
TYPESENSE_API_KEY=typesense-dev-key
OPENAI_API_KEY=
# Optional override for another OpenAI-compatible API.
# OPENAI_BASE_URL=https://api.openai.com/v1
SEARCH_EMBEDDING_MODEL=text-embedding-3-small
SEARCH_EMBEDDING_DIMENSIONS=1536
# Entry images are analyzed automatically; uses SEARCH_ASK_MODEL when unset.
# Requires a vision-capable model with JSON output support.
# ASSET_ANALYSIS_MODEL=
SEARCH_ASK_MODEL=gpt-5.6-luna
SEARCH_ASK_REASONING_EFFORT=none

# Image storage. Leave ASSET_S3_BUCKET unset to disable image uploads.
# Use a private bucket. Backend and worker require the same storage configuration.
# Standard AWS credentials are used when explicit credentials are omitted.
# ASSET_S3_BUCKET=
# ASSET_S3_REGION=us-east-1
# ASSET_S3_ENDPOINT=https://your-s3-compatible-endpoint
# ASSET_S3_ACCESS_KEY_ID=
# ASSET_S3_SECRET_ACCESS_KEY=
# ASSET_S3_FORCE_PATH_STYLE=false
# Limits are bytes and pixels. Pending uploads reserve space for processing outputs.
ASSET_MAX_UPLOAD_BYTES=10485760
ASSET_MAX_INPUT_PIXELS=25000000
ASSET_STORAGE_BYTES=10737418240
# Also applies when billing is not configured.
PRO_ASSET_STORAGE_BYTES=53687091200
ASSET_UPLOAD_EXPIRY_HOURS=3
# Retain completed images this many days after their final reference is removed.
ASSET_RETENTION_DAYS=7

# Optional cloud billing. Leave these unset for self-hosting with all Pro features.
# Billing is enabled only when all five Stripe settings are non-empty.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_SEAT_PRICE_ID=
# STRIPE_PRO_API_CALL_PRICE_ID=
# STRIPE_PRO_API_CALL_METER_EVENT_NAME=

# Optional API allowances for cloud billing (defaults shown).
# INCLUDED_API_CALLS=1000
# PRO_INCLUDED_API_CALLS=500000

# Version retention
VERSION_RETENTION_DAYS=7
PRO_VERSION_RETENTION_DAYS=30

# Email
SENDER_EMAIL=
SENDER_NAME=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

### External services configuration

# UserCheck (service checking for fake emails): `true` or [API key]
USER_CHECK=

# Resend (email service)
RESEND_API_KEY=

# SMTP (alternative email service)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=
